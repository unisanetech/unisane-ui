{
  "name": "unisane-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Material Design 3 React Component Library",
  "repository": {
    "type": "git",
    "url": "https://github.com/unisane/unisane-ui.git"
  },
  "scripts": {
    "build": "turbo run build",
    "check:border-semantics": "node scripts/check-semantic-border-roles.mjs",
    "check:utility-ownership": "node scripts/check-public-utility-ownership.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "check:quality": "pnpm --filter @unisane/tokens test && pnpm --filter @unisane/ui validate && pnpm check:border-semantics && pnpm check:utility-ownership && pnpm -w architecture:check && pnpm -w typecheck",
    "storybook": "turbo run storybook",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "prettier": "^3.6.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=18"
  }
}

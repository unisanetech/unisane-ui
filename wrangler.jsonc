{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unisane-ui",
  "compatibility_date": "2026-08-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/docs/out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [
    {
      "pattern": "ui.unisane.com",
      "custom_domain": true,
    },
  ],
}

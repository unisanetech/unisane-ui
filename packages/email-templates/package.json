{
  "name": "@unisane/email-templates",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "unisane.meta.json"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22",
    "@unisane/typescript-config": "workspace:*",
    "tsc-alias": "^1.8.10",
    "typescript": "5.9.2",
    "vitest": "^4.0.16"
  },
  "unisane": {
    "kind": "ui",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}

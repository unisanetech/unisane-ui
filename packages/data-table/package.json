{
  "name": "@unisane/data-table",
  "version": "0.1.0",
  "description": "High-performance, feature-rich DataTable component for Unisane UI",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "unisane.meta.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./hooks/data": {
      "types": "./dist/hooks/data/index.d.ts",
      "import": "./dist/hooks/data/index.js",
      "default": "./dist/hooks/data/index.js"
    },
    "./hooks/ui": {
      "types": "./dist/hooks/ui/index.d.ts",
      "import": "./dist/hooks/ui/index.js",
      "default": "./dist/hooks/ui/index.js"
    },
    "./hooks/features": {
      "types": "./dist/hooks/features/index.d.ts",
      "import": "./dist/hooks/features/index.js",
      "default": "./dist/hooks/features/index.js"
    },
    "./hooks/utilities": {
      "types": "./dist/hooks/utilities/index.d.ts",
      "import": "./dist/hooks/utilities/index.js",
      "default": "./dist/hooks/utilities/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "default": "./dist/constants/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js",
      "default": "./dist/context/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js",
      "default": "./dist/export.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "default": "./dist/i18n/index.js"
    },
    "./print": {
      "types": "./dist/print.d.ts",
      "import": "./dist/print.js",
      "default": "./dist/print.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./meta": "./unisane.meta.json"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/unisane/unisane-ui.git",
    "directory": "packages/data-table"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js && tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "check:border-semantics": "node ../../scripts/check-semantic-border-roles.mjs",
    "check-types": "tsc --noEmit",
    "clean": "node ../../scripts/clean-package-output.mjs",
    "dev": "tsc --watch",
    "lint": "eslint src tests --max-warnings 0 && pnpm check:border-semantics",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@unisane/ui": "workspace:*",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@tailwindcss/cli": "4.1.18",
    "@types/node": "^22",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.0.17",
    "eslint": "^9.39.1",
    "happy-dom": "20.3.1",
    "tsc-alias": "^1.8.10",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.2",
    "vitest": "4.0.17"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.18",
    "dequal": "^2.0.3",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "xlsx": "^0.18.5"
  },
  "unisane": {
    "kind": "ui",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}

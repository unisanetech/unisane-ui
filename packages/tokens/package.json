{
  "name": "@unisane/tokens",
  "version": "0.1.0-next.b67ebfd0.1",
  "description": "Semantic design tokens and generated CSS for Unisane interfaces",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unisanetech/unisane-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/unisanetech/unisane-ui#readme",
  "bugs": {
    "url": "https://github.com/unisanetech/unisane-ui/issues"
  },
  "keywords": [
    "design-tokens",
    "css",
    "tailwindcss",
    "theme",
    "theming"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "unisane.meta.json"
  ],
  "exports": {
    ".": "./dist/unisane.css",
    "./unisane.css": "./dist/unisane.css",
    "./preview-themes.css": "./dist/preview-themes.css",
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "pnpm clean && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-package-output.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test scripts/tokens-build/__tests__/build-output.test.mjs",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 node --test scripts/tokens-build/__tests__/build-output.test.mjs",
    "lint": "eslint scripts --max-warnings 0"
  },
  "devDependencies": {
    "chokidar": "^3.5.3",
    "eslint": "^9.39.1"
  },
  "unisane": {
    "kind": "ui",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}

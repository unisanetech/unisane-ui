{
  "name": "@unisane/tokens",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "unisane.meta.json"
  ],
  "exports": {
    ".": "./dist/unisane.css",
    "./unisane.css": "./dist/unisane.css",
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test scripts/tokens-build/__tests__/build-output.test.mjs",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 node --test scripts/tokens-build/__tests__/build-output.test.mjs",
    "lint": "echo 'No lint targets for @unisane/tokens'"
  },
  "devDependencies": {
    "chokidar": "^3.5.3"
  },
  "unisane": {
    "kind": "ui",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./theme-override.schema.json",
  "title": "Unisane Tokens Theme Override",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "primary"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hue": { "type": "number", "minimum": 0, "maximum": 360 },
        "chroma": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

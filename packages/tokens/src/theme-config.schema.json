{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./theme-config.schema.json",
  "title": "Unisane Tokens Theme Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "primary", "secondary", "tertiary", "neutral", "error", "success", "warning", "info"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue", "chroma"],
      "properties": {
        "hue": { "type": "number", "minimum": 0, "maximum": 360 },
        "chroma": { "type": "number", "minimum": 0, "maximum": 1 },
        "comment": { "type": "string" }
      }
    },
    "secondary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "hueShift", "chromaScale"],
      "properties": {
        "strategy": { "type": "string", "enum": ["analogous", "complementary", "custom"] },
        "hueShift": { "type": "number", "minimum": -360, "maximum": 360 },
        "chromaScale": { "type": "number", "minimum": 0, "maximum": 2 },
        "comment": { "type": "string" }
      }
    },
    "tertiary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "hueShift", "chromaScale"],
      "properties": {
        "strategy": { "type": "string", "enum": ["analogous", "complementary", "custom"] },
        "hueShift": { "type": "number", "minimum": -360, "maximum": 360 },
        "chromaScale": { "type": "number", "minimum": 0, "maximum": 2 },
        "comment": { "type": "string" }
      }
    },
    "neutral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tintFromPrimary"],
      "properties": {
        "strategy": { "type": "string" },
        "tintFromPrimary": { "type": "number", "minimum": 0, "maximum": 1 },
        "comment": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue", "chroma"],
      "properties": {
        "hue": { "type": "number", "minimum": 0, "maximum": 360 },
        "chroma": { "type": "number", "minimum": 0, "maximum": 1 },
        "comment": { "type": "string" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue", "chroma"],
      "properties": {
        "hue": { "type": "number", "minimum": 0, "maximum": 360 },
        "chroma": { "type": "number", "minimum": 0, "maximum": 1 },
        "comment": { "type": "string" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue", "chroma"],
      "properties": {
        "hue": { "type": "number", "minimum": 0, "maximum": 360 },
        "chroma": { "type": "number", "minimum": 0, "maximum": 1 },
        "comment": { "type": "string" }
      }
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue", "chroma"],
      "properties": {
        "hue": { "type": "number", "minimum": 0, "maximum": 360 },
        "chroma": { "type": "number", "minimum": 0, "maximum": 1 },
        "comment": { "type": "string" }
      }
    }
  }
}

  "license": "MIT",
  "scripts": {
    "build": "pnpm build:components && pnpm build:styles && pnpm check:runtime-exports",
    "build:registry": "node scripts/build-registry.mjs",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "check:contract": "node scripts/check-component-contract.mjs",
    "check:raw-colors": "node scripts/check-raw-colors.mjs",
    "check:runtime-exports": "node scripts/check-runtime-exports.mjs",
    "check-types": "tsc --noEmit",
    "check-types:registry": "tsc --noEmit -p tsconfig.registry.json",
    "test": "vitest run --config vitest.config.ts",
    "test:registry-contract": "node --test scripts/__tests__/registry-contract.test.mjs",
    "validate": "pnpm test && pnpm check-types && pnpm check:contract && pnpm check:raw-colors && pnpm validate:registry",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0 && pnpm check:contract",
    "validate:registry": "node scripts/validate-registry.mjs && pnpm test:registry-contract && pnpm check-types:registry"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/node": "^22",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@unisane/eslint-config": "workspace:*",
    "@unisane/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.18",
    "tsc-alias": "^1.8.10",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@unisane/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "unisane": {
    "kind": "ui",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}

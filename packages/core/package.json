{
  "name": "@unisane/ui",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "registry",
    "unisane.meta.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./components/sidebar": {
      "types": "./dist/components/sidebar/index.d.ts",
      "import": "./dist/components/sidebar/index.js",
      "default": "./dist/components/sidebar/index.js"
    },
    "./components/navigation": {
      "types": "./dist/components/navigation/index.d.ts",
      "import": "./dist/components/navigation/index.js",
      "default": "./dist/components/navigation/index.js"
    },
    "./components/data-table": {
      "types": "./dist/components/data-table/index.d.ts",
      "import": "./dist/components/data-table/index.js",
      "default": "./dist/components/data-table/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js",
      "default": "./dist/primitives/*.js"
    },
    "./layout/*": {
      "types": "./dist/layout/*.d.ts",
      "import": "./dist/layout/*.js",
      "default": "./dist/layout/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./meta": "./unisane.meta.json"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm build:components && pnpm build:styles",
    "build:registry": "node scripts/build-registry.mjs",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "check:contract": "node scripts/check-component-contract.mjs",
    "check:raw-colors": "node scripts/check-raw-colors.mjs",
    "check-types": "tsc --noEmit",
    "check-types:registry": "tsc --noEmit -p tsconfig.registry.json",
    "test": "vitest run --config vitest.config.ts",
    "validate": "pnpm test && pnpm check-types && pnpm check:contract && pnpm check:raw-colors && pnpm validate:registry",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0 && pnpm check:contract",
    "validate:registry": "node scripts/validate-registry.mjs && pnpm check-types:registry"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/node": "^22",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@unisane/eslint-config": "workspace:*",
    "@unisane/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.18",
    "tsc-alias": "^1.8.10",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@unisane/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "unisane": {
    "kind": "ui",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}
